      addAeno(8 * state.civ);
      setDialog(pickDialog("study", planet, assistant));
      toast(`語言學習 +${8 * state.civ} AENO`, "ok");
      break;
    case "mutate":
      setDialog(pickDialog("mutate", planet, assistant));
      break;
  }
  afterAction();
}

function afterAction() {
